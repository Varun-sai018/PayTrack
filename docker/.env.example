# PayTrack Environment Configuration (DO NOT commit real values)
# Copy this file to .env and fill in actual values. .env is git-ignored.

# ==========================================
# MySQL (one user per schema)
# ==========================================
MYSQL_ROOT_PASSWORD=changeme_root_password
SPRING_DATASOURCE_USERNAME=paytrack
SPRING_DATASOURCE_PASSWORD=changeme_db_password

# ==========================================
# JWT (shared by gateway and auth only, min 32 bytes)
# ==========================================
JWT_SECRET=changeme_jwt_secret_at_least_32_bytes_long
JWT_ACCESS_TOKEN_EXPIRATION=900000
JWT_REFRESH_TOKEN_EXPIRATION=604800000

# ==========================================
# Gateway
# ==========================================
GATEWAY_SECRET=changeme_gateway_secret_at_least_32_bytes
GATEWAY_KEY_SECRET=changeme_gateway_key_secret

# ==========================================
# Internal service-to-service key
# ==========================================
INTERNAL_API_KEY=changeme_internal_api_key

# ==========================================
# Admin bootstrap
# ==========================================
ADMIN_EMAIL=admin@paytrack.local
ADMIN_PASSWORD=changeme_admin_password

# ==========================================
# RabbitMQ
# ==========================================
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=changeme_rabbitmq_password

# ==========================================
# Limits (INR)
# ==========================================
PAYTRACK_LIMITS_MIN_AMOUNT=1.00
PAYTRACK_LIMITS_MAX_TRANSACTION=10000
PAYTRACK_LIMITS_DAILY_TOTAL=25000
PAYTRACK_RECHARGE_MIN=10
PAYTRACK_RECHARGE_MAX=2000
PAYTRACK_TIMEZONE=Asia/Kolkata

# ==========================================
# Spring profiles
# ==========================================
SPRING_PROFILES_ACTIVE=dev
